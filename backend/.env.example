# Copy to backend/.env (never commit the real file) and export before starting:
#   set -a && source .env && set +a && uvicorn app.main:app --reload

# Which extractor reads documents: rules (free, offline), llm or hybrid.
EXTRACTOR=rules

# Needed for llm and hybrid.
LLM_PROVIDER=openai            # openai or anthropic
LLM_MODEL=                     # the model id from your provider, e.g. a vision-capable model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # or an Azure / EU-hosted compatible endpoint
LLM_TIMEOUT_SECONDS=60

# Storage and demo data. A file path uses SQLite; a postgresql:// URL uses PostgreSQL.
DATABASE_URL=intake.db
# DATABASE_URL=postgresql://intake:change-me@localhost:5432/intake
SEED_DEMO=1
CORS_ORIGINS=http://localhost:5173
# Add your web app's address here if it is not on localhost:5173,
# e.g. https://<you>.github.io to use the hosted demo against this API.

# Sign-in. Keep AUTH_REQUIRED=1 anywhere but a local demo.
AUTH_REQUIRED=1
# Long random string; keeps signed file links valid across restarts.
SECRET_KEY=
# Demo accounts (only with SEED_DEMO=1). Never seed demo data on a server with real data.
# DEMO_PASSWORD=DemoPass2026

# Reminder emails. Without SMTP_HOST they are written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# Original files: database (default), local, or s3.
FILE_STORAGE=database
# FILE_STORAGE_DIR=uploads
# S3 (or any S3-compatible store). Pick an EU region for UK/EU client data.
# S3_BUCKET=
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                 # only for non-AWS providers, e.g. https://fsn1.your-objectstorage.com
# S3_PREFIX=intake
