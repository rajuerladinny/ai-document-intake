# Copy to backend/.env (never commit the real file) and export before starting:
#   set -a && source .env && set +a && uvicorn app.main:app --reload

# Which extractor reads documents: rules (free, offline), llm or hybrid.
EXTRACTOR=rules

# Needed for llm and hybrid.
LLM_PROVIDER=openai            # openai or anthropic
LLM_MODEL=                     # the model id from your provider, e.g. a vision-capable model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # or an Azure / EU-hosted compatible endpoint
LLM_TIMEOUT_SECONDS=60

# Storage and demo data.
DATABASE_PATH=intake.db
SEED_DEMO=1
CORS_ORIGINS=http://localhost:5173
